<?xml version="1.0" encoding="utf-8" ?>
<ex:WindowEx
    x:Class="Trdo.Controls.TutorialWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="using:WinUIEx"
    xmlns:local="using:Trdo.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Trdo First Run Window"
    Width="400"
    Height="600"
    IsMaximizable="False"
    IsMinimizable="False"
    mc:Ignorable="d">

    <ex:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </ex:WindowEx.SystemBackdrop>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="ModernTitlebar" Title="Trdo">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/Radio.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <StackPanel
            Grid.Row="1"
            Orientation="Vertical"
            Spacing="8">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubheaderTextBlockStyle}"
                Text="Welcome to Trdo" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="A tiny tray radio for Windows" />
            <TextBlock HorizontalAlignment="Center">
                How to use:<LineBreak />
                1. Pin the icon to be visibile<LineBreak />
                2. Left click to play/pause<LineBreak />
                3. Right click for everything else!<LineBreak />
            </TextBlock>
            <Image Grid.Row="1" Source="/Assets/Tutorial.gif" />
        </StackPanel>
        <Button
            Grid.Row="2"
            Margin="0,12"
            HorizontalAlignment="Center"
            Click="Button_Click"
            Content="Ready to go!"
            Style="{StaticResource AccentButtonStyle}" />

    </Grid>

</ex:WindowEx>

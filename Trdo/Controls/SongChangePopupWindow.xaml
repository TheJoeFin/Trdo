<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Trdo.Controls.SongChangePopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        The window itself is see-through (TransparentTintBackdrop, applied in
        code-behind), so everything outside SurfaceBorder shows the desktop.
        RootGrid deliberately has no fixed size: the window is sized and placed
        by WindowPlacementService, and the pill hugs its own content.
    -->
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        IsHitTestVisible="False">
        <Border
            x:Name="SurfaceBorder"
            AutomationProperties.AutomationId="SongChangePopupSurface"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="Now playing"
            MaxWidth="520"
            Margin="20,20,20,16"
            Padding="18,14"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}"
            Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SurfaceTransform" Y="24" />
            </Border.RenderTransform>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <FontIcon
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="22"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="&#xE8D6;" />
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Now playing" />
                    <TextBlock
                        x:Name="SongText"
                        MaxLines="2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

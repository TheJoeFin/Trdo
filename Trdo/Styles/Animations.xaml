<?xml version="1.0" encoding="utf-8" ?>
<!--
    Shared implicit-animation sets (CommunityToolkit.WinUI.Animations) used across pages so
    that elements toggling Visibility fade/slide instead of snapping, and elements that shift
    position when a sibling appears or disappears glide to their new spot instead of jumping.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations">

    <animations:ImplicitAnimationSet x:Key="ImplicitFadeShowAnimations">
        <animations:OpacityAnimation
            Duration="0:0:0.25"
            EasingMode="EaseOut"
            EasingType="Cubic"
            From="0"
            To="1" />
        <animations:TranslationAnimation
            Duration="0:0:0.25"
            EasingMode="EaseOut"
            EasingType="Cubic"
            From="0,-8,0"
            To="0,0,0" />
    </animations:ImplicitAnimationSet>

    <animations:ImplicitAnimationSet x:Key="ImplicitFadeHideAnimations">
        <animations:OpacityAnimation
            Duration="0:0:0.15"
            EasingMode="EaseIn"
            EasingType="Cubic"
            From="1"
            To="0" />
        <animations:TranslationAnimation
            Duration="0:0:0.15"
            EasingMode="EaseIn"
            EasingType="Cubic"
            From="0,0,0"
            To="0,-8,0" />
    </animations:ImplicitAnimationSet>

    <!--  Plain opacity cross-fade, for elements that swap in place (e.g. static text vs. a marquee).  -->
    <animations:ImplicitAnimationSet x:Key="ImplicitCrossFadeShowAnimations">
        <animations:OpacityAnimation
            Duration="0:0:0.2"
            EasingMode="EaseOut"
            EasingType="Cubic"
            From="0"
            To="1" />
    </animations:ImplicitAnimationSet>

    <animations:ImplicitAnimationSet x:Key="ImplicitCrossFadeHideAnimations">
        <animations:OpacityAnimation
            Duration="0:0:0.15"
            EasingMode="EaseIn"
            EasingType="Cubic"
            From="1"
            To="0" />
    </animations:ImplicitAnimationSet>

    <!--  Glides an element to its new Offset/Size instead of snapping when a sibling's visibility change reflows the layout.  -->
    <animations:ImplicitAnimationSet x:Key="ImplicitReflowAnimations">
        <animations:OffsetAnimation
            Duration="0:0:0.3"
            EasingMode="EaseOut"
            EasingType="Cubic" />
        <animations:SizeAnimation
            Duration="0:0:0.3"
            EasingMode="EaseOut"
            EasingType="Cubic" />
    </animations:ImplicitAnimationSet>

</ResourceDictionary>

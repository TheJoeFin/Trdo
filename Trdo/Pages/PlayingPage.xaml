<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Trdo.Pages.PlayingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Trdo.Controls"
    xmlns:converters="using:Trdo.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:labs="using:CommunityToolkit.Labs.WinUI.MarqueeTextRns"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Trdo.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:CountToEmptyStateVisibilityConverter x:Key="CountToEmptyStateVisibilityConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter" />
        <converters:PercentStringConverter x:Key="PercentStringConverter" />

        <!--
            Station row. Column 0 holds the indentation rail, which collapses to zero width for
            a station that is not in a folder - so an ungrouped list renders exactly as it did
            before folders existed.
        -->
        <DataTemplate x:Key="StationRowTemplate" x:DataType="models:RadioStation">
            <Grid ColumnDefinitions="Auto,Auto,*">
                <Grid.ContextFlyout>
                    <!--
                        The three original commands stay first and in their original order:
                        this menu has been the same since 1.x and muscle memory is worth more
                        than a tidier grouping.
                    -->
                    <MenuFlyout Opening="StationContextMenu_Opening">
                        <MenuFlyoutItem
                            Click="VisitSite_Click"
                            Tag="{x:Bind}"
                            Text="Visit Website">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xEB41;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Click="EditStation_Click"
                            Tag="{x:Bind}"
                            Text="Edit">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE70F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Click="RemoveStation_Click"
                            Tag="{x:Bind}"
                            Text="Remove">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutSubItem x:Name="MoveToGroupSubItem" Text="Move to group">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xE8DE;" />
                            </MenuFlyoutSubItem.Icon>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutItem
                            Click="InsertDividerAbove_Click"
                            Tag="{x:Bind}"
                            Text="Insert divider above">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE738;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Click="RefreshStationInfo_Click"
                            Tag="{x:Bind}"
                            Text="Refresh station info">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE72C;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>

                <!--  Selection indicator  -->
                <Border
                    x:Name="SelectionIndicator"
                    Grid.ColumnSpan="3"
                    Margin="-8,-6"
                    Background="{ThemeResource AccentAcrylicBackgroundFillColorDefaultBrush}"
                    CornerRadius="2"
                    Visibility="{x:Bind IsSelectedStation,
                                        Converter={StaticResource BooleanToVisibilityConverter},
                                        Mode=OneWay}" />

                <!--  Indentation rail, shown only for a station inside a folder  -->
                <Border
                    Grid.Column="0"
                    Width="1"
                    Margin="6,0,10,0"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Visibility="{x:Bind GroupId,
                                        Converter={StaticResource NullToVisibilityConverter},
                                        Mode=OneWay}" />

                <!--  Favicon  -->
                <Grid
                    Grid.Column="1"
                    Width="24"
                    Height="24"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind FaviconUrl,
                                        Converter={StaticResource NullToVisibilityConverter},
                                        Mode=OneWay}">
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4">
                        <Image Source="{x:Bind FaviconUrl, Converter={StaticResource StringToImageSourceConverter}, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border>
                </Grid>

                <!--  Station Name  -->
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="{x:Bind Name, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </Grid>
        </DataTemplate>

        <!--  Folder header. Tapping anywhere on the row expands or collapses it.  -->
        <DataTemplate x:Key="StationGroupRowTemplate" x:DataType="models:StationGroup">
            <Grid
                Background="Transparent"
                ColumnDefinitions="Auto,*,Auto"
                Tapped="GroupRow_Tapped">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            Click="RenameGroup_Click"
                            Tag="{x:Bind}"
                            Text="Rename">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8AC;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <!--
                            Removing the folder keeps the stations, so it needs no confirming -
                            same reasoning as removing a single station. Throwing the stations
                            away is a separate, explicitly worded command that does confirm.
                        -->
                        <MenuFlyoutItem
                            Click="DeleteGroup_Click"
                            Tag="{x:Bind}"
                            Text="Delete group">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Click="DeleteGroupAndStations_Click"
                            Tag="{x:Bind}"
                            Text="Delete group and its stations" />
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <FontIcon
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="{x:Bind Name, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <TextBlock
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind StationCount, Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <!--  Divider: a rule, with the caption inline when there is one.  -->
        <DataTemplate x:Key="StationDividerRowTemplate" x:DataType="models:StationDivider">
            <Grid
                Background="Transparent"
                ColumnDefinitions="Auto,Auto,*"
                Tapped="DividerRow_Tapped">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            Click="EditDividerLabel_Click"
                            Tag="{x:Bind}"
                            Text="Edit label">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE70F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Click="RemoveDivider_Click"
                            Tag="{x:Bind}"
                            Text="Remove divider">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <Border
                    Grid.Column="0"
                    Width="1"
                    Margin="6,0,10,0"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Visibility="{x:Bind GroupId,
                                        Converter={StaticResource NullToVisibilityConverter},
                                        Mode=OneWay}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind Label, Mode=OneWay}"
                    Visibility="{x:Bind HasLabel,
                                        Converter={StaticResource BooleanToVisibilityConverter},
                                        Mode=OneWay}" />
                <Border
                    Grid.Column="2"
                    Height="1"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Grid>
        </DataTemplate>

        <controls:StationRowTemplateSelector
            x:Key="StationRowTemplateSelector"
            DividerTemplate="{StaticResource StationDividerRowTemplate}"
            GroupTemplate="{StaticResource StationGroupRowTemplate}"
            StationTemplate="{StaticResource StationRowTemplate}" />

        <Style x:Key="StationRowContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,1" />
        </Style>

        <Style x:Key="StationGroupRowContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,1" />
        </Style>

        <Style x:Key="StationDividerRowContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,0,1" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <controls:StationRowContainerStyleSelector
            x:Key="StationRowContainerStyleSelector"
            DividerStyle="{StaticResource StationDividerRowContainerStyle}"
            GroupStyle="{StaticResource StationGroupRowContainerStyle}"
            StationStyle="{StaticResource StationRowContainerStyle}" />
    </Page.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" RowSpacing="12">
        <Grid.ContextFlyout>
            <MenuFlyout x:Name="PageContextMenu" Opening="PageContextMenu_Opening">
                <MenuFlyoutItem
                    x:Name="NewGroupMenuItem"
                    Click="NewGroup_Click"
                    Text="New Group">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    x:Name="NewDividerMenuItem"
                    Click="NewDivider_Click"
                    Text="New Divider">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE738;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem x:Name="SortBySubItem" Text="Sort by">
                    <MenuFlyoutSubItem.Icon>
                        <FontIcon Glyph="&#xE8CB;" />
                    </MenuFlyoutSubItem.Icon>
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    x:Name="RefreshAllInfoMenuItem"
                    Click="RefreshAllStationInfo_Click"
                    Text="Refresh info for all stations">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE72C;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    x:Name="ShowVolumeMenuItem"
                    Click="ToggleVolumeSlider_Click"
                    Text="Show Volume Slider">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE767;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Add Station Button  -->
            <Button
                Grid.Column="0"
                VerticalAlignment="Center"
                Click="AddStationButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE710;" />
                    <TextBlock Text="Station" />
                </StackPanel>
            </Button>

            <!--  Favorites Icon Button (Subtle)  -->
            <Button
                Grid.Column="2"
                Padding="8"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="FavoritesButton_Click"
                ToolTipService.ToolTip="Favorite Songs">
                <FontIcon FontSize="16" Glyph="&#xE728;" />
            </Button>

            <!--  Info Icon Button (Subtle)  -->
            <Button
                Grid.Column="3"
                Padding="8"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="InfoButton_Click"
                ToolTipService.ToolTip="About Traydio">
                <FontIcon FontSize="16" Glyph="&#xE946;" />
            </Button>

            <!--  Settings Icon Button (Subtle)  -->
            <Button
                Grid.Column="4"
                Padding="8"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="SettingsButton_Click"
                ToolTipService.ToolTip="Settings">
                <FontIcon FontSize="16" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <!--  Stations Header  -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <TextBlock
                Grid.Column="0"
                FontSize="16"
                FontWeight="SemiBold"
                Text="Stations" />

            <!--
                Only shown while a view sort is active. Names all three surprises at once -
                folders hidden, dividers hidden, dragging off - because meeting them one at a
                time reads like a bug.
            -->
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="2"
                Visibility="{x:Bind ViewModel.IsViewSorted,
                                    Converter={StaticResource BooleanToVisibilityConverter},
                                    Mode=OneWay}">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind ViewModel.SortHintText, Mode=OneWay}" />
                <HyperlinkButton
                    Padding="4,0"
                    VerticalAlignment="Center"
                    Click="ResetSort_Click"
                    Content="Manual"
                    FontSize="11" />
            </StackPanel>
        </Grid>

        <!--  Stations List  -->
        <Grid Grid.Row="2">
            <ListView
                x:Name="StationsListView"
                AllowDrop="True"
                CanDragItems="True"
                CanReorderItems="True"
                DragItemsCompleted="StationsListView_DragItemsCompleted"
                DragItemsStarting="StationsListView_DragItemsStarting"
                ItemContainerStyleSelector="{StaticResource StationRowContainerStyleSelector}"
                ItemTemplateSelector="{StaticResource StationRowTemplateSelector}"
                ItemsSource="{x:Bind ViewModel.DisplayRows,
                                     Mode=OneWay}"
                SelectionChanged="StationsListView_SelectionChanged"
                SelectionMode="Single" />

            <!--  Empty State  -->
            <Grid
                x:Name="EmptyStatePanel"
                Padding="6"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.StationCount,
                                    Mode=OneWay,
                                    Converter={StaticResource CountToEmptyStateVisibilityConverter}}">
                <StackPanel
                    MaxWidth="240"
                    HorizontalAlignment="Center"
                    Spacing="8">
                    <!--  Radio Icon  -->
                    <Viewbox
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Center">
                        <FontIcon
                            FontSize="80"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Glyph="&#xE95A;" />
                    </Viewbox>

                    <!--  Welcome Message  -->
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="No Stations Yet"
                        TextAlignment="Center" />

                    <!--  Description  -->
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Get started by adding your favorite radio station to begin listening."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <!--  Add Station Button  -->
                    <Button
                        HorizontalAlignment="Center"
                        Click="AddStationButton_Click"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE710;" />
                            <TextBlock Text="Add Your First Station" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!--  Volume Control  -->
        <Grid
            x:Name="VolumeControlGrid"
            Grid.Row="3"
            Background="Transparent"
            ColumnSpacing="8"
            PointerWheelChanged="VolumeControl_PointerWheelChanged">
            <Grid.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Click="HideVolumeSlider_Click" Text="Hide Volume Slider" />
                </MenuFlyout>
            </Grid.ContextFlyout>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="20"
                Glyph="&#xE767;" />
            <Slider
                x:Name="VolumeSlider"
                Grid.Column="1"
                Maximum="200"
                Minimum="0"
                SmallChange="1"
                StepFrequency="1"
                ThumbToolTipValueConverter="{StaticResource PercentStringConverter}"
                Value="{x:Bind ViewModel.VolumePercent,
                               Mode=TwoWay}" />
            <TextBlock
                Grid.Column="2"
                MinWidth="40"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.VolumePercent,
                              Mode=OneWay,
                              Converter={StaticResource PercentStringConverter}}"
                TextAlignment="Right" />
        </Grid>

        <!--  Now Playing Info  -->
        <Button
            x:Name="NowPlayingButton"
            Grid.Row="4"
            Padding="8,4"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderThickness="0"
            Click="NowPlayingInfo_Click"
            CornerRadius="4"
            ToolTipService.ToolTip="Click for details"
            Visibility="{x:Bind ViewModel.HasNowPlaying,
                                Mode=OneWay,
                                Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid VerticalAlignment="Center" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                    Glyph="&#xE8D6;" />
                <Grid
                    x:Name="NowPlayingTextHost"
                    Grid.Column="1"
                    SizeChanged="NowPlayingTextHost_SizeChanged">
                    <labs:MarqueeText
                        x:Name="NowPlayingMarqueeText"
                        VerticalAlignment="Center"
                        Behavior="Looping"
                        Direction="Left"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        RepeatBehavior="1x"
                        Speed="40"
                        Text="{x:Bind ViewModel.NowPlaying,
                                      Mode=OneWay}"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="NowPlayingText"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.NowPlaying,
                                      Mode=OneWay}"
                        TextTrimming="Clip"
                        TextWrapping="NoWrap" />
                </Grid>
                <!--  Favorite Button  -->
                <Button
                    x:Name="FavoriteButton"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="FavoriteButton_Click"
                    ToolTipService.ToolTip="Favorite Song">
                    <FontIcon
                        x:Name="FavoriteIcon"
                        FontSize="14"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="&#xE734;" />
                </Button>
                <FontIcon
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE76C;" />
            </Grid>
        </Button>

        <!--  Playback Actions  -->
        <Grid Grid.Row="5" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="PlayButton"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                Click="PlayButton_Click"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon FontSize="16" Glyph="{x:Bind ViewModel.PlaybackButtonGlyph, Mode=OneWay}" />
                    <TextBlock FontSize="12" Text="{x:Bind ViewModel.PlaybackButtonText, Mode=OneWay}" />
                </StackPanel>
            </Button>

            <HyperlinkButton
                Grid.Column="1"
                VerticalAlignment="Center"
                Click="PopOutButton_Click"
                ToolTipService.ToolTip="Open mini player">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="16" Glyph="&#xE93A;" />
                </StackPanel>
            </HyperlinkButton>

            <HyperlinkButton
                Grid.Column="2"
                VerticalAlignment="Center"
                Click="CloseButton_Click"
                Content="Quit"
                ToolTipService.ToolTip="Quit Traydio" />
        </Grid>
    </Grid>
</Page>

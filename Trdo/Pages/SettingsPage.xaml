<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Trdo.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Trdo.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="SettingCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="NestedSettingCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SettingTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingStatusStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <Grid RowDefinitions="Auto,*" RowSpacing="24">
        <!--  Settings Title  -->
        <TextBlock
            Grid.Row="0"
            FontSize="24"
            FontWeight="SemiBold"
            Text="Settings" />

        <!--  Settings Content  -->
        <ScrollView Grid.Row="1">
            <StackPanel Padding="0,0,8,8" Spacing="12">
                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SettingTitleStyle}" Text="Open on startup" />
                        <TextBlock Style="{StaticResource SettingDescriptionStyle}" Text="Launch Traydio automatically when you sign in so the player is ready without opening it manually." />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <ToggleSwitch
                                x:Name="StartupToggle"
                                Grid.Column="0"
                                MinWidth="0"
                                IsEnabled="{x:Bind ViewModel.IsStartupToggleEnabled,
                                                   Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.IsStartupEnabled,
                                              Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource SettingStatusStyle}"
                                Text="{x:Bind ViewModel.StartupToggleText,
                                              Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SettingTitleStyle}" Text="Play on startup" />
                        <TextBlock Style="{StaticResource SettingDescriptionStyle}" Text="Automatically resume the last station as soon as Traydio opens." />
                        <InfoBar
                            x:Name="AutoPlayWarningInfoBar"
                            Margin="-12"
                            IsClosable="True"
                            IsOpen="False"
                            Message="This means audio will begin playing when Traydio is launched. It could be disruptive. Are you sure you want to enable this?"
                            Severity="Warning">
                            <InfoBar.ActionButton>
                                <Button
                                    x:Name="ConfirmAutoPlayButton"
                                    Click="ConfirmAutoPlayButton_Click"
                                    Content="Enable" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <ToggleSwitch
                                x:Name="AutoPlayOnStartupToggle"
                                Grid.Column="0"
                                MinWidth="0"
                                IsOn="{x:Bind ViewModel.IsAutoPlayOnStartupEnabled,
                                              Mode=OneWay}"
                                OffContent=""
                                OnContent=""
                                Toggled="AutoPlayOnStartupToggle_Toggled" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource SettingStatusStyle}"
                                Text="{x:Bind ViewModel.AutoPlayOnStartupToggleText,
                                              Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SettingTitleStyle}" Text="Tray icon click behavior" />
                        <TextBlock Style="{StaticResource SettingDescriptionStyle}" Text="Choose whether the tray icon prioritizes playback controls or opening the player." />
                        <ComboBox SelectedIndex="{x:Bind ViewModel.TrayClickBehavior, Mode=TwoWay}">
                            <ComboBoxItem Content="Left click: play/pause, right click: open Traydio (Default)" />
                            <ComboBoxItem Content="Left click: open Traydio, right click: play/pause" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SettingTitleStyle}" Text="Music search services" />
                        <TextBlock Style="{StaticResource SettingDescriptionStyle}" Text="Choose which shortcuts appear on Now Playing and Favorites when you want to search for the current song elsewhere." />

                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Image
                                    Grid.Column="0"
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center">
                                    <Image.Source>
                                        <SvgImageSource UriSource="ms-appx:///Assets/spotify.svg" />
                                    </Image.Source>
                                </Image>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="Spotify"
                                    TextWrapping="Wrap" />
                                <ToggleSwitch
                                    Grid.Column="2"
                                    MinWidth="0"
                                    HorizontalAlignment="Right"
                                    IsOn="{x:Bind ViewModel.IsSpotifyEnabled,
                                                  Mode=TwoWay}"
                                    OffContent=""
                                    OnContent="" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Image
                                    Grid.Column="0"
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center">
                                    <Image.Source>
                                        <SvgImageSource UriSource="ms-appx:///Assets/discogs.svg" />
                                    </Image.Source>
                                </Image>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="Discogs"
                                    TextWrapping="Wrap" />
                                <ToggleSwitch
                                    Grid.Column="2"
                                    MinWidth="0"
                                    HorizontalAlignment="Right"
                                    IsOn="{x:Bind ViewModel.IsDiscogsEnabled,
                                                  Mode=TwoWay}"
                                    OffContent=""
                                    OnContent="" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Image
                                    Grid.Column="0"
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center">
                                    <Image.Source>
                                        <SvgImageSource UriSource="ms-appx:///Assets/apple_music.svg" />
                                    </Image.Source>
                                </Image>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="Apple Music"
                                    TextWrapping="Wrap" />
                                <ToggleSwitch
                                    Grid.Column="2"
                                    MinWidth="0"
                                    HorizontalAlignment="Right"
                                    IsOn="{x:Bind ViewModel.IsAppleMusicEnabled,
                                                  Mode=TwoWay}"
                                    OffContent=""
                                    OnContent="" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Image
                                    Grid.Column="0"
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center">
                                    <Image.Source>
                                        <SvgImageSource UriSource="ms-appx:///Assets/ytmusic.svg" />
                                    </Image.Source>
                                </Image>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="YouTube Music"
                                    TextWrapping="Wrap" />
                                <ToggleSwitch
                                    Grid.Column="2"
                                    MinWidth="0"
                                    HorizontalAlignment="Right"
                                    IsOn="{x:Bind ViewModel.IsYouTubeMusicEnabled,
                                                  Mode=TwoWay}"
                                    OffContent=""
                                    OnContent="" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SettingTitleStyle}" Text="Playback engine" />
                        <TextBlock Style="{StaticResource SettingDescriptionStyle}" Text="Choose how Traydio plays streams. Auto uses LibVLC first and falls back to Windows Media Foundation when needed." />
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            SelectedIndex="{x:Bind ViewModel.PlaybackEngineModeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Auto (recommended)" />
                            <ComboBoxItem Content="Native only" />
                            <ComboBoxItem Content="Native preferred" />
                        </ComboBox>
                        <TextBlock
                            Style="{StaticResource SettingStatusStyle}"
                            Text="{x:Bind ViewModel.PlaybackEngineModeDescription, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <InfoBar
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.IsLibVlcUnavailableOnThisDevice}"
                            Message="On ARM devices the LibVLC engine isn't available, so streams always play through the Windows engine no matter which option you pick. Higher-than-100% volume also won't apply."
                            Severity="Warning" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SettingTitleStyle}" Text="Auto-recover" />
                        <TextBlock Style="{StaticResource SettingDescriptionStyle}" Text="Monitor playback and automatically try to recover when a stream stalls, drops out, or goes silent." />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <ToggleSwitch
                                x:Name="WatchdogToggle"
                                Grid.Column="0"
                                MinWidth="0"
                                IsOn="{x:Bind ViewModel.IsWatchdogEnabled,
                                              Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource SettingStatusStyle}"
                                Text="{x:Bind ViewModel.WatchdogToggleText,
                                              Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}" Visibility="{x:Bind ViewModel.IsWatchdogEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SettingTitleStyle}" Text="Silence detection timeout" />
                        <TextBlock Style="{StaticResource SettingDescriptionStyle}" Text="Set how long playback can stay silent before Traydio restarts the stream automatically." />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                            <Slider
                                x:Name="SilenceTimeoutSlider"
                                Grid.Column="0"
                                Maximum="30"
                                Minimum="1"
                                SnapsTo="StepValues"
                                StepFrequency="1"
                                Value="{x:Bind ViewModel.SilenceTimeoutSeconds,
                                               Mode=TwoWay}" />
                            <TextBlock
                                Grid.Column="1"
                                MinWidth="36"
                                Style="{StaticResource SettingStatusStyle}"
                                Text="{x:Bind ViewModel.SilenceTimeoutDisplay,
                                              Mode=OneWay}" />
                            <StackPanel
                                Grid.Column="2"
                                Height="18"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="2">
                                <Rectangle
                                    x:Name="Bar1"
                                    Width="3"
                                    Height="4"
                                    VerticalAlignment="Bottom"
                                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                    Opacity="0.15"
                                    RadiusX="1"
                                    RadiusY="1" />
                                <Rectangle
                                    x:Name="Bar2"
                                    Width="3"
                                    Height="7"
                                    VerticalAlignment="Bottom"
                                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                    Opacity="0.15"
                                    RadiusX="1"
                                    RadiusY="1" />
                                <Rectangle
                                    x:Name="Bar3"
                                    Width="3"
                                    Height="10"
                                    VerticalAlignment="Bottom"
                                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                    Opacity="0.15"
                                    RadiusX="1"
                                    RadiusY="1" />
                                <Rectangle
                                    x:Name="Bar4"
                                    Width="3"
                                    Height="13"
                                    VerticalAlignment="Bottom"
                                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                    Opacity="0.15"
                                    RadiusX="1"
                                    RadiusY="1" />
                                <Rectangle
                                    x:Name="Bar5"
                                    Width="3"
                                    Height="18"
                                    VerticalAlignment="Bottom"
                                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                    Opacity="0.15"
                                    RadiusX="1"
                                    RadiusY="1" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SettingTitleStyle}" Text="Auto-increase buffer on stutter" />
                        <TextBlock Style="{StaticResource SettingDescriptionStyle}" Text="Let Traydio raise the buffer automatically when the stream is struggling to stay smooth." />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <ToggleSwitch
                                x:Name="AutoBufferToggle"
                                Grid.Column="0"
                                MinWidth="0"
                                IsOn="{x:Bind ViewModel.IsAutoBufferIncreaseEnabled,
                                              Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource SettingStatusStyle}"
                                Text="{x:Bind ViewModel.AutoBufferToggleText,
                                              Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SettingTitleStyle}" Text="Buffer level" />
                        <TextBlock Style="{StaticResource SettingDescriptionStyle}" Text="Higher buffer levels help on unstable connections, but they can add a little more playback delay." />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Slider
                                x:Name="BufferLevelSlider"
                                Grid.Column="0"
                                Maximum="3"
                                Minimum="0"
                                SnapsTo="StepValues"
                                StepFrequency="0.1"
                                Value="{x:Bind ViewModel.BufferLevel,
                                               Mode=TwoWay}" />
                            <TextBlock
                                Grid.Column="1"
                                MinWidth="92"
                                Style="{StaticResource SettingStatusStyle}"
                                Text="{x:Bind ViewModel.BufferLevelDescription,
                                              Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SettingTitleStyle}" Text="Allow PC to sleep" />
                        <TextBlock Style="{StaticResource SettingDescriptionStyle}" Text="Let the computer go to sleep on its normal schedule while radio is playing. Note that Windows itself may keep the PC awake while any audio is playing." />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <ToggleSwitch
                                x:Name="AllowSleepToggle"
                                Grid.Column="0"
                                MinWidth="0"
                                IsOn="{x:Bind ViewModel.AllowSleepWhilePlaying,
                                              Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource SettingStatusStyle}"
                                Text="{x:Bind ViewModel.AllowSleepToggleText,
                                              Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SettingTitleStyle}" Text="Import / Export stations" />
                        <TextBlock Style="{StaticResource SettingDescriptionStyle}" Text="Back up your station list or move it to another device with M3U and PLS playlist files." />
                        <StackPanel Orientation="Vertical" Spacing="8">
                            <Button
                                x:Name="ImportButton"
                                Click="ImportButton_Click"
                                Content="Import stations" />
                            <Button
                                x:Name="ExportButton"
                                Click="ExportButton_Click"
                                Content="Export stations" />
                        </StackPanel>
                        <InfoBar
                            x:Name="ImportExportInfoBar"
                            IsClosable="True"
                            IsOpen="False" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SettingTitleStyle}" Text="Diagnostics" />
                        <TextBlock Style="{StaticResource SettingDescriptionStyle}" Text="Traydio keeps a log of playback activity (which engine was used, stream status, and errors). Open the log folder or copy recent diagnostics to share when reporting a problem." />
                        <StackPanel Orientation="Vertical" Spacing="8">
                            <Button
                                x:Name="OpenLogsFolderButton"
                                Click="OpenLogsFolderButton_Click"
                                Content="Open logs folder" />
                            <Button
                                x:Name="CopyDiagnosticsButton"
                                Click="CopyDiagnosticsButton_Click"
                                Content="Copy diagnostics" />
                        </StackPanel>
                        <InfoBar
                            x:Name="DiagnosticsInfoBar"
                            IsClosable="True"
                            IsOpen="False" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollView>
    </Grid>
</Page>

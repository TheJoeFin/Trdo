<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Trdo.Pages.AddStation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Trdo.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Trdo.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Trdo.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:CountToEmptyStateVisibilityConverter x:Key="EmptyCollectionVisibilityConverter" />
        <converters:CountToHasItemsVisibilityConverter x:Key="HasItemsVisibilityConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:EditModeVisibilityConverter x:Key="EditModeVisibilityConverter" />
    </Page.Resources>

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">

        <!--  Title  -->
        <TextBlock
            Grid.Row="0"
            FontSize="20"
            FontWeight="SemiBold"
            Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" />

        <!--  Content Area  -->
        <Grid Grid.Row="1">
            <!--  Search Mode  -->
            <Grid
                RowDefinitions="Auto,*,Auto"
                RowSpacing="12"
                Visibility="{x:Bind ViewModel.IsSearchMode, Mode=OneWay}">
                <!--  Search Input  -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox
                        x:Name="SearchTextBox"
                        Grid.Column="0"
                        PlaceholderText="Search by station name..."
                        Text="{x:Bind ViewModel.SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ProgressRing
                        Grid.Column="1"
                        Width="20"
                        Height="20"
                        IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}" />
                </Grid>

                <!--  Search Results  -->
                <ScrollViewer Grid.Row="1">
                    <StackPanel Spacing="8">
                        <!--  Initial state with manual entry option  -->
                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowInitialState, Mode=OneWay}">
                            <TextBlock
                                FontStyle="Italic"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Enter a search term to find stations..."
                                TextAlignment="Center" />
                            <HyperlinkButton
                                HorizontalAlignment="Center"
                                Click="ManualEntryButton_Click"
                                Content="Or add station manually" />
                        </StackPanel>

                        <ListView
                            Margin="0"
                            Padding="0"
                            ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedSearchResult, Mode=TwoWay}"
                            SelectionMode="Single"
                            Visibility="{x:Bind ViewModel.SearchResults.Count, Mode=OneWay, Converter={StaticResource HasItemsVisibilityConverter}}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:RadioBrowserStation">
                                    <Grid
                                        Margin="0,6"
                                        RowDefinitions="Auto,Auto"
                                        RowSpacing="4">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Name}"
                                            TextWrapping="WrapWholeWords" />
                                        <TextBlock Grid.Row="1" TextWrapping="WrapWholeWords">
                                            <Run
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Country}" />
                                            <Run
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Tags}" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>

                <!--  Selected Station Display (in search mode)  -->
                <Border
                    Grid.Row="2"
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{x:Bind ViewModel.SelectedSearchResult, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="Selected Station" />

                        <!--  Station Name  -->
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Station Name" />
                            <TextBlock Text="{x:Bind ViewModel.StationName, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>

                        <!--  Stream URL  -->
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Stream URL" />
                            <TextBlock
                                FontSize="12"
                                Text="{x:Bind ViewModel.StreamUrl, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!--  Manual Mode  -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsManualMode, Mode=OneWay}">
                <!--  Station Name Input  -->
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="Station Name" />
                    <TextBox
                        x:Name="StationNameTextBox"
                        PlaceholderText="e.g., WYMS - Hometown radio"
                        Text="{x:Bind ViewModel.StationName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!--  Stream URL Input  -->
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="Stream URL" />
                    <TextBox
                        x:Name="StreamUrlTextBox"
                        PlaceholderText="e.g., https://example.com/stream"
                        Text="{x:Bind ViewModel.StreamUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!--  Buttons  -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                Click="CancelButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE711;" />
                    <TextBlock Text="Cancel" />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Click="SaveButton_Click"
                IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE74E;" />
                    <TextBlock Text="Save" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>

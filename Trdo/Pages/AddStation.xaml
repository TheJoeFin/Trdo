<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Trdo.Pages.AddStation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Trdo.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Trdo.Models"
    xmlns:converters="using:Trdo.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:CountToEmptyStateVisibilityConverter x:Key="EmptyCollectionVisibilityConverter" />
        <converters:CountToHasItemsVisibilityConverter x:Key="HasItemsVisibilityConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:EditModeVisibilityConverter x:Key="EditModeVisibilityConverter" />
    </Page.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">

        <!--  Title  -->
        <TextBlock
            Grid.Row="0"
            FontSize="20"
            FontWeight="SemiBold"
            Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" />

        <!--  Mode Selector (only show when not editing)  -->
        <StackPanel Grid.Row="1" Spacing="8" Visibility="{x:Bind ViewModel.PageTitle, Mode=OneWay, Converter={StaticResource EditModeVisibilityConverter}}">
            <TextBlock FontWeight="SemiBold" Text="Add Station Method" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <RadioButton
                    Content="Manual Entry"
                    IsChecked="{x:Bind ViewModel.IsManualMode, Mode=TwoWay}"
                    GroupName="AddMode" />
                <RadioButton
                    Content="Search Online"
                    IsChecked="{x:Bind ViewModel.IsSearchMode, Mode=OneWay}"
                    GroupName="AddMode" />
            </StackPanel>
        </StackPanel>

        <!--  Content Area  -->
        <Grid Grid.Row="2">
            <!--  Search Mode  -->
            <Grid Visibility="{x:Bind ViewModel.IsSearchMode, Mode=OneWay}" RowDefinitions="Auto,*,Auto" RowSpacing="12">
                <!--  Search Input  -->
                <StackPanel Grid.Row="0" Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="Search for Radio Stations" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox
                            Grid.Column="0"
                            x:Name="SearchTextBox"
                            PlaceholderText="Search by station name..."
                            Text="{x:Bind ViewModel.SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ProgressRing
                            Grid.Column="1"
                            Width="20"
                            Height="20"
                            IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}" />
                    </Grid>
                </StackPanel>

                <!--  Search Results  -->
                <ScrollViewer Grid.Row="1">
                    <StackPanel Spacing="8">
                        <TextBlock
                            FontStyle="Italic"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Enter a search term to find stations..."
                            Visibility="{x:Bind ViewModel.SearchResults.Count, Mode=OneWay, Converter={StaticResource EmptyCollectionVisibilityConverter}}" />

                        <ListView
                            ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedSearchResult, Mode=TwoWay}"
                            SelectionMode="Single"
                            Visibility="{x:Bind ViewModel.SearchResults.Count, Mode=OneWay, Converter={StaticResource HasItemsVisibilityConverter}}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:RadioBrowserStation">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="8">
                                        <FontIcon
                                            Grid.Column="0"
                                            FontSize="20"
                                            Glyph="&#xE768;" />
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Name}"
                                                TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Country}" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Tags}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>

                <!--  Selected Station Display (in search mode)  -->
                <Border
                    Grid.Row="2"
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{x:Bind ViewModel.SelectedSearchResult, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="Selected Station" />
                        
                        <!--  Station Name  -->
                        <StackPanel Spacing="2">
                            <TextBlock 
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Station Name" />
                            <TextBlock
                                Text="{x:Bind ViewModel.StationName, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!--  Stream URL  -->
                        <StackPanel Spacing="2">
                            <TextBlock 
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Stream URL" />
                            <TextBlock
                                FontSize="12"
                                Text="{x:Bind ViewModel.StreamUrl, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!--  Manual Mode  -->
            <StackPanel Visibility="{x:Bind ViewModel.IsManualMode, Mode=OneWay}" Spacing="12">
                <!--  Station Name Input  -->
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="Station Name" />
                    <TextBox
                        x:Name="StationNameTextBox"
                        PlaceholderText="e.g., WYMS - Hometown radio"
                        Text="{x:Bind ViewModel.StationName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!--  Stream URL Input  -->
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="Stream URL" />
                    <TextBox
                        x:Name="StreamUrlTextBox"
                        PlaceholderText="e.g., https://example.com/stream"
                        Text="{x:Bind ViewModel.StreamUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!--  Buttons  -->
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                Click="CancelButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE711;" />
                    <TextBlock Text="Cancel" />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Click="SaveButton_Click"
                IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE74E;" />
                    <TextBlock Text="Save" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>

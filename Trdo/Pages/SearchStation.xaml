<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Trdo.Pages.SearchStation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Trdo.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Trdo.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:CountToHasItemsVisibilityConverter x:Key="HasItemsVisibilityConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter" />
    </Page.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">

        <!--  Title  -->
        <TextBlock
            Grid.Row="0"
            FontSize="20"
            FontWeight="SemiBold"
            Text="Search Radio Stations" />

        <!--  Search Input  -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="8">
            <TextBox
                x:Name="SearchTextBox"
                Grid.Column="0"
                PlaceholderText="Search by station name..."
                Text="{x:Bind ViewModel.SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ProgressRing
                Grid.Column="1"
                Width="20"
                Height="20"
                IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}" />
        </Grid>

        <!--  Error InfoBar  -->
        <InfoBar
            Title="Search Error"
            Grid.Row="2"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />

        <!--  Search Results  -->
        <ScrollView Grid.Row="3">
            <StackPanel Spacing="8">
                <!--  Initial state  -->
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowInitialState, Mode=OneWay}">
                    <TextBlock
                        FontStyle="Italic"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Enter a search term to find stations..."
                        TextAlignment="Center" />
                    <HyperlinkButton
                        HorizontalAlignment="Center"
                        Click="ManualEntryButton_Click"
                        Content="Or add station manually" />
                </StackPanel>

                <!--  Results List  -->
                <ListView
                    Margin="0"
                    Padding="0"
                    ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                    SelectionMode="None"
                    Visibility="{x:Bind ViewModel.SearchResults.Count, Mode=OneWay, Converter={StaticResource HasItemsVisibilityConverter}}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:RadioBrowserStation">
                            <Border
                                Margin="0,4"
                                Padding="6"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="12"
                                    RowDefinitions="Auto,Auto,Auto"
                                    RowSpacing="4">

                                    <!--  Favicon  -->
                                    <Grid
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="0"
                                        Width="40"
                                        Height="40"
                                        VerticalAlignment="Top"
                                        Visibility="{x:Bind Favicon, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}">
                                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6">
                                            <Image Source="{x:Bind Favicon, Converter={StaticResource StringToImageSourceConverter}, Mode=OneWay}" Stretch="UniformToFill" />
                                        </Border>
                                    </Grid>

                                    <!--  Station Name  -->
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Name}"
                                        TextWrapping="WrapWholeWords" />

                                    <!--  Station Info  -->
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        TextWrapping="WrapWholeWords">
                                        <Run
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Country}" />
                                        <Run
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text=" • " />
                                        <Run
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Tags}" />
                                    </TextBlock>

                                    <!--  Preview & Add Buttons  -->
                                    <StackPanel
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Margin="0,4,0,0"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <Button
                                            Click="PreviewButton_Click"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="Preview station">
                                            <FontIcon FontSize="14" Glyph="&#xE768;" />
                                        </Button>
                                        <Button
                                            Click="EditStationButton_Click"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="Edit station details before adding">
                                            <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                        </Button>
                                        <Button
                                            Click="AddStationButton_Click"
                                            Content="Add Station"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Tag="{x:Bind}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollView>

        <!--  Cancel Button  -->
        <Button
            Grid.Row="4"
            HorizontalAlignment="Stretch"
            Click="CancelButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontSize="16" Glyph="&#xE711;" />
                <TextBlock Text="Cancel" />
            </StackPanel>
        </Button>
    </Grid>
</Page>
